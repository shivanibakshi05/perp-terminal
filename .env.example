# ---------------------------------------------------------------------------
# Copy to .env.local. .env.local is gitignored — never commit a private key.
# ---------------------------------------------------------------------------

# Deploy key. Use a THROWAWAY account that has only ever held testnet funds.
# MetaMask -> Add account -> name it "testnet-deployer" -> Account details ->
# Show private key. Fund it from a Base Sepolia faucet.
DEPLOYER_PRIVATE_KEY=

# Optional: override the public RPC endpoints with your own (Alchemy/Infura).
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# ---------------------------------------------------------------------------
# Frontend. Filled in by `npm run deploy:baseSepolia` — it prints these for you.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_PERP_ADDRESS=
NEXT_PUBLIC_COLLATERAL_ADDRESS=

# Read-only RPC used for demo mode (no wallet required).
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Market data feed. Binance public WebSocket needs no API key.
NEXT_PUBLIC_WS_BASE=wss://stream.binance.com:9443/ws
NEXT_PUBLIC_REST_BASE=https://api.binance.com
