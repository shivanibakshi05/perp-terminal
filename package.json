{
  "name": "perp-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "On-chain perpetuals trading terminal — Next.js, TypeScript, ethers.js v6, WebSockets",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "chain": "hardhat node",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:baseSepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "deploy:arbitrumSepolia": "hardhat run scripts/deploy.ts --network arbitrumSepolia",
    "test:book": "tsx scripts/verifyBook.ts"
  },
  "dependencies": {
    "ethers": "^6.13.4",
    "lightweight-charts": "^4.2.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.15",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "solc": "^0.8.24",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
